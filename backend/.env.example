# ==============================================================================
# KickOff Backend Environment Configuration
# Duplicate this file to .env and supply your credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/kickoff_db
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/kickoff_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kickoff_db

# JWT Secret & Expiry
JWT_SECRET=kickoff_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRE=7d

# Razorpay Test Credentials (Get from dashboard.razorpay.com)
# In development test mode, orders can also run in simulated mode if keys are empty
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Nodemailer / SMTP Configuration (e.g., Gmail App Password or Ethereal test account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=KickOff Arena <noreply@kickoffarena.com>
