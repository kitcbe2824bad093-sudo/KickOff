# ==============================================================================
# KickOff Frontend Environment Variables Template
# Duplicate to .env and configure keys
# ==============================================================================

# Backend API Base URL (Leave empty if using Vite proxy, or specify http://localhost:5000/api)
VITE_API_BASE_URL=/api

# Google Maps API Key for embed / interactive map view
# If left empty, a beautiful OpenStreetMap / Google Maps fallback embed is automatically displayed
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Test Key ID (Matches backend key)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
