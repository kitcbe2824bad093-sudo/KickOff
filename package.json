{
  "name": "kickoff-football-court-booking",
  "version": "1.0.0",
  "description": "KickOff - Full-Stack Football Court Booking and Management System (MERN)",
  "main": "backend/server.js",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node backend/seed.js",
    "build": "npm run build --prefix frontend"
  },
  "keywords": [
    "mern",
    "football",
    "turf-booking",
    "court-reservation",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
